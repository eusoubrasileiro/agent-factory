{
  "name": "@amiticia/factory",
  "version": "0.1.0",
  "description": "AmiticIA software factory — AI-agent mission engine (plan→build→validate) with a live board, serving any product via projects/<id>/ profiles",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "test": "FACTORY_AUTOPUBLISH=0 FACTORY_PR=0 node --test \"scripts/*.test.mjs\" \"scripts/lib/*.test.mjs\" \"projects/*/*.test.mjs\"",
    "board:sync": "node scripts/board-sync.mjs",
    "board:report": "node scripts/board-report.mjs",
    "board:publish": "bash scripts/board-publish.sh",
    "board:autopublish": "node scripts/board-autopublish.mjs",
    "intake": "node scripts/intake-server.mjs",
    "mission:ratify": "node scripts/ratify.mjs",
    "factory:opencode": "node scripts/opencode-worker.mjs",
    "spend": "node scripts/spend.mjs",
    "kpi": "node scripts/kpi.mjs",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "backlog.md": "^1.47.1",
    "husky": "^9.1.7"
  }
}
