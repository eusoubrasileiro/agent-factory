{
  "id": "factory",
  "name": "Factory engine (dogfood)",
  "path": ".",
  "prd": null,
  "trunk": "main",
  "branchPrefix": "agent/",
  "worktreeMarker": "/.worktrees/",
  "gate": [
    "pnpm test"
  ],
  "prepare": [
    "pnpm install --frozen-lockfile"
  ],
  "prepareMarker": "node_modules",
  "gateConfig": [
    "package.json#/scripts"
  ],
  "noCanonicalE2E": "pending onboarding review — no canonical e2e defined yet (flagged 2026-07-23)",
  "dispatch": "git worktree add .worktrees/{slug} -b agent/{slug}"
}
