# Rendered board output — regenerated by board-report / board-autopublish.
dist/

# Publish funnel side-channels (soft-fail logs + content-hash memo).
.publish.log
dist/factory-board/.hash

# PR projection side-channel: records why a `gh` call failed on THIS machine.
# The `PR` marker itself is mission state and stays tracked.
missions/**/.pr.log

# VPS deploy secrets (basicauth users live here, never commit).
deploy/.env
deploy/factory-board/.env

# Node
node_modules/

# Engine self-hosting: git worktrees for factory missions.
.worktrees/

# ── Rendered artifacts: screenshots, diagrams, mockups ──────────────────────
# Ratified 2026-07-21. Validators and playwright probes generate these by design —
# they SHOULD exist on disk, they must never enter git.
# .gitignore is a CRITICAL FILE — do not weaken without Andre's approval.
# Location-based, not `*.png`: this repo has no source images today, but a board
# asset or a doc diagram would be a legitimate future addition.
# Supersedes the old per-file board-screenshot denies (/factory-board.png, …).
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.pdf
docs/**/*.png
docs/**/*.jpg
docs/**/*.jpeg
docs/**/*.html
missions/**/screenshots/
**/screenshots/
**/.playwright-mcp/
test-results/

# Published board output — rsynced here by board-autopublish.mjs on the VPS
# (/opt/app/factory/public/). Live data, not source: a `git clean -fd` in
# the deploy checkout would erase the running board.
/public/
